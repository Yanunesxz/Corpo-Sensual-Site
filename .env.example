# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# No Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ser exposta no navegador: o acesso é controlado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contato exibido no site (opcional). Números só com dígitos, com DDI: 5532999999999
NEXT_PUBLIC_WHATSAPP=
# Os WhatsApp da equipe (gerente comercial, SAC, financeiro e vendedoras) ficam em
# `equipe`, dentro de src/lib/site.ts, porque são fixos e públicos.
NEXT_PUBLIC_TELEFONE=
# Vazio = @pijamascorposensual, o perfil oficial (padrão em src/lib/site.ts).
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_EMAIL=
# Horário de atendimento, texto livre. Ex.: Segunda a sexta, das 8h às 17h
NEXT_PUBLIC_HORARIO=

# CRM (CSP 360): cada lead vira prospecto + negócio no funil "Venda Direta — Leads".
# Chave SÓ do servidor (sem NEXT_PUBLIC): mesmo valor do secret LEAD_SITE_CHAVE_CS
# da Edge Function `lead-site` no Supabase do CRM. Vazia = lead fica "pendente".
LEAD_SITE_CHAVE=
# Opcional: endereço da função. O padrão já está em src/lib/crm.ts e aponta para
# `dynamic-endpoint`, que é como a função foi publicada no Supabase do CRM. Se um dia
# ela for republicada com o nome certo (`lead-site`), é aqui que se aponta o novo
# endereço sem precisar mexer no código.
# LEAD_SITE_URL=https://brwyvxrueogayjsqfkbo.supabase.co/functions/v1/lead-site

# Google Analytics 4: ID de medição do fluxo da Web (G-XXXXXXXXXX). O ID também pode
# ficar fixo em src/lib/analytics.ts (GA_ID_DO_SITE); a variável, se existir, manda.
# Sem ID nenhum = nenhum script do Google e nenhum aviso de cookies.
# As variáveis NEXT_PUBLIC_ entram no código na hora do build: depois de mudar, faça
# um novo deploy. As prévias da Vercel nunca medem.
NEXT_PUBLIC_GA_ID=
# Opcional: conversão do Google Ads no formato AW-CONTA/RÓTULO. Vazio = sem Google Ads.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSAO=
# Opcional: token extra do Search Console (método "Tag HTML"). O token que o Wix já
# publica fica fixo em src/app/layout.tsx.
GOOGLE_SITE_VERIFICATION=
