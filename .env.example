# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# No Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ser exposta no navegador: o acesso é controlado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada em metadados, sitemap e links absolutos)
NEXT_PUBLIC_SITE_URL=https://www.corposensual.com.br

# Contato exibido no site (opcional). Números só com dígitos, com DDI: 5532999999999
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_TELEFONE=
NEXT_PUBLIC_INSTAGRAM=corposensual
NEXT_PUBLIC_EMAIL=
# Horário de atendimento, texto livre. Ex.: Segunda a sexta, das 8h às 17h
NEXT_PUBLIC_HORARIO=

# CRM (CSP 360): cada lead vira prospecto + negócio no funil "Venda Direta — Leads".
# Chave SÓ do servidor (sem NEXT_PUBLIC): mesmo valor do secret LEAD_SITE_CHAVE_CS
# da Edge Function `lead-site` no Supabase do CRM. Vazia = lead fica "pendente".
LEAD_SITE_CHAVE=
# Opcional: endereço da função. O padrão já está em src/lib/crm.ts e aponta para
# `dynamic-endpoint`, que é como a função foi publicada no Supabase do CRM. Se um dia
# ela for republicada com o nome certo (`lead-site`), é aqui que se aponta o novo
# endereço sem precisar mexer no código.
# LEAD_SITE_URL=https://brwyvxrueogayjsqfkbo.supabase.co/functions/v1/lead-site
